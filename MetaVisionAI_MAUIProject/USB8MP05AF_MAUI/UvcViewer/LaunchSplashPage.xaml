<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UvcViewer.LaunchSplashPage"
             BackgroundColor="#06142E"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False">
    <Grid BackgroundColor="#06142E">
        <!-- Full-screen image: contains the mark, name, and tagline. -->
        <Image Source="meta_muse_launch.png"
               Aspect="AspectFill"
               HorizontalOptions="Fill"
               VerticalOptions="Fill"
               InputTransparent="True"
               SemanticProperties.Description="Meta Muse AI. Voice-Powered Barcode Intelligence. Powered by Muse Spark 1.3." />
    </Grid>
</ContentPage>
