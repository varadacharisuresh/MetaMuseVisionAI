<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0-android</TargetFramework>
		<OutputType>Exe</OutputType>
		<RootNamespace>UvcViewer</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<ApplicationTitle>Meta Muse AI</ApplicationTitle>
		<ApplicationId>com.metaai.goggles</ApplicationId>
		<ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>
		<SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
		<AndroidPackageFormat>apk</AndroidPackageFormat>
	</PropertyGroup>
	<Import Project="DroidUvc.NativeFix.props" Condition="Exists('DroidUvc.NativeFix.props')" />
	<ItemGroup>
		<None Remove="Resources\Images\icon_apply.png" />
		<None Remove="Resources\Images\icon_close.png" />
		<None Remove="Resources\Images\icon_collapse.png" />
		<None Remove="Resources\Images\icon_expand.png" />
		<None Remove="Resources\Images\icon_settings.png" />
		<None Remove="Resources\Images\fab_*.png" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<!-- Android uses Google ML Kit; no ZXing.Net decoder dependency. -->
		<PackageReference Include="BarcodeScanning.Native.Maui" Version="3.1.0" />
		<!-- Keep the UVC Maven dependency identical to the WORKING version. -->
		<AndroidMavenLibrary Include="io.github.mikimn:droiduvc" Version="0.2.1" Bind="false" VerifyDependencies="false" />
	</ItemGroup>
	<ItemGroup>
		<AndroidNativeLibrary Include="Platforms\Android\jni\arm64-v8a\libdroiduvc.so" Abi="arm64-v8a" />

		<AndroidNativeLibrary Include="Platforms\Android\jni\arm64-v8a\libc++_shared.so" Abi="arm64-v8a" />
	</ItemGroup>
	<ItemGroup>

		<MauiIcon Include="Resources\AppIcon\appicon.png"
				  ForegroundFile="Resources\AppIcon\appiconfg.png"
				  ForegroundScale="0.65"
				  BaseSize="1024,1024" />

		<MauiImage Include="Resources\Images\icon_apply.png" />
		<MauiImage Include="Resources\Images\icon_close.png" />
		<MauiImage Include="Resources\Images\icon_collapse.png" />
		<MauiImage Include="Resources\Images\icon_expand.png" />
		<MauiImage Include="Resources\Images\icon_settings.png" />
		<MauiImage Include="Resources\Images\fab_*.png" />
		<MauiSplashScreen Include="Resources/Splash/splash.png" Color="#0b1424" BaseSize="128,128" />
	</ItemGroup>
</Project>
